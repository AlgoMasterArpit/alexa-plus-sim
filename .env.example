HOST=127.0.0.1
PORT=8788
LOG_LEVEL=info

# Which Claude endpoint plays the assistant: bedrock (default) or anthropic.
SIM_LLM_PROVIDER=bedrock
# Leave empty for the provider default (anthropic.claude-opus-5-5 on Bedrock, claude-opus-5-5 on the Anthropic API).
SIM_MODEL=
# low keeps spoken replies fast; raise it for servers with complex tool chains.
SIM_EFFORT=low

# Bedrock uses the default AWS credential chain. The identity needs bedrock-mantle:CreateInference.
BEDROCK_REGION=us-east-1

# The Anthropic API provider reads ANTHROPIC_API_KEY from the environment.
# ANTHROPIC_API_KEY=

# Prefills the server URL in the connect form.
SIM_DEFAULT_SERVER_URL=http://127.0.0.1:8787/mcp
